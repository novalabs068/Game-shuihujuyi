[sub_resource type="Resource" id="Resource_sbmb5"]
script = ExtResource("4_1w5cy")
id = &"jiu_bao"
display_name = "酒保"
sprite = ExtResource("5_6tdh0")
cell = Vector2i(35, 37)
lines = PackedStringArray("客官里边请！这快活林原是施管营家小官人的，后来被蒋门神占了，前些日子又给夺了回来。", "如今蒋门神的徒弟还常来闹事，赌坊那边更是乌烟瘴气。")

[sub_resource type="Resource" id="Resource_8jglg"]
script = ExtResource("4_1w5cy")
id = &"xiao_fan"
display_name = "货郎"
sprite = ExtResource("6_grgdu")
cell = Vector2i(61, 42)
lines = PackedStringArray("快活林的货，比孟州城里还全！要什么？")
action = &"market"

[sub_resource type="Resource" id="Resource_enl20"]
script = ExtResource("4_1w5cy")
