[sub_resource type="Resource" id="Resource_vyxfh"]
script = ExtResource("2_4tth7")
id = &"old_monk"
display_name = "看园老僧"
cell = Vector2i(9, 8)
lines = PackedStringArray("看园老僧：智深师兄，长老吩咐你来看管这片菜园。", "看园老僧：这附近有二三十个泼皮，常来偷菜，师兄可要当心。", "我：洒家倒要看看，是哪个不怕死的。")

[sub_resource type="Resource" id="Resource_dgu0q"]
script = ExtResource("2_4tth7")
id = &"zhang_san"
display_name = "泼皮张三"
cell = Vector2i(31, 7)
lines = PackedStringArray("泼皮张三：听说新来了个胖和尚管菜园？兄弟们正要去「贺喜」呢，嘿嘿。", "（张三朝粪窖那边使了个眼色。）")

[sub_resource type="Resource" id="Resource_s2na7"]
script = ExtResource("2_4tth7")
id = &"li_si"
display_name = "泼皮李四"
cell = Vector2i(32, 8)
lines = PackedStringArray("泼皮李四：大师！小的们特来拜见。", "泼皮李四：请大师走到粪窖边上来，受我们一拜……", "（这事以后再说——支线在第 4 步做。）")

[sub_resource type="Resource" id="Resource_arty7"]
script = ExtResource("2_4tth7")
id = &"lin_chong"
display_name = "林冲"
unit = ExtResource("3_fe4vo")
cell = Vector2i(16, 10)
lines = PackedStringArray("林冲：好一个胖大和尚！这条禅杖使得端的是好！", "我：洒家鲁智深。官人是谁？", "林冲：在下林冲，八十万禁军枪棒教头。今日得见师兄，三生有幸！")

