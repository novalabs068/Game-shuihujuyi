lines = PackedStringArray("泼皮李四：大师！小的们特来拜见。", "泼皮李四：请大师走到粪窖边上来，受我们一拜……", "（这事以后再说——支线在第 4 步做。）")

[sub_resource type="Resource" id="Resource_arty7"]
