[sub_resource type="Resource" id="Resource_vyxfh"]
script = ExtResource("2_4tth7")
id = &"old_monk"
display_name = "看园老僧"
sprite = ExtResource("5_kb5ui")
cell = Vector2i(9, 8)
lines = PackedStringArray("看园老僧：施主是来上香的？这片菜园如今归智深师兄看管。", "看园老僧：附近有二三十个泼皮，常来偷菜。施主若会些拳脚，还望帮衬一二。")

[sub_resource type="Resource" id="Resource_dgu0q"]
script = ExtResource("2_4tth7")
id = &"zhang_san"
display_name = "泼皮张三"
sprite = ExtResource("6_vxuke")
cell = Vector2i(31, 7)
lines = PackedStringArray("泼皮张三：哪来的？少管闲事！", "泼皮张三：那胖和尚今天要倒大霉了，嘿嘿。", "（张三朝粪窖那边使了个眼色。）")
hide_flag = "garden_done"

[sub_resource type="Resource" id="Resource_n23ah"]
script = ExtResource("7_ao81w")
label = "去提醒鲁智深"
result_text = "鲁智深听了哈哈大笑：「洒家倒要看看他们怎么掀！」
第二天泼皮们来「拜见」，还没近身，就被鲁智深一脚一个踢进了粪窖。从此再没人敢来偷菜。"
tokens = 2
flag = "garden_done"

[sub_resource type="Resource" id="Resource_efgxc"]
script = ExtResource("11_46cpb")
id = "garden_brawl"
title = "菜园泼皮"
enemies = Array[ExtResource("8_1rfvs")]([ExtResource("9_npk5w"), ExtResource("10_d7yj5"), ExtResource("9_npk5w")])
enemy_level = 4
recommended_level = 4

[sub_resource type="Resource" id="Resource_anb1j"]
script = ExtResource("7_ao81w")
label = "当场教训他们"
result_text = "{name}三拳两脚，把泼皮们打得哭爹喊娘，一个个滚进了粪窖。鲁智深闻声赶来，拍着你的肩膀直叫好。"
tokens = 2
battle = SubResource("Resource_efgxc")
flag = "garden_done"

[sub_resource type="Resource" id="Resource_0oj20"]
script = ExtResource("7_ao81w")
label = "在一旁看热闹"
result_text = "泼皮们去「拜」鲁智深，结果被他一脚一个踢进了粪窖。你在一旁笑出了眼泪。"
experience = 20
flag = "garden_done"

[sub_resource type="Resource" id="Resource_kyp5f"]
script = ExtResource("12_e7ffu")
id = &"garden_pranksters"
title = "菜园泼皮"
text = "李四压低声音：「那胖和尚新来管菜园，我们兄弟要请他到粪窖边受一拜，到时候一人抱一条腿，把他掀下粪窖去！你可别坏我们好事。」"
choices = Array[ExtResource("7_ao81w")]([SubResource("Resource_n23ah"), SubResource("Resource_anb1j"), SubResource("Resource_0oj20")])
once = true

