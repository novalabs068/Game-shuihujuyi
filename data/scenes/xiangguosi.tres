[sub_resource type="Resource" id="Resource_vyxfh"]
script = ExtResource("2_4tth7")
id = &"old_monk"
display_name = "看园老僧"
sprite = ExtResource("5_kb5ui")
cell = Vector2i(9, 8)
lines = PackedStringArray("看园老僧：智深师兄，长老吩咐你来看管这片菜园。", "看园老僧：这附近有二三十个泼皮，常来偷菜，师兄可要当心。", "我：洒家倒要看看，是哪个不怕死的。")

[sub_resource type="Resource" id="Resource_dgu0q"]
script = ExtResource("2_4tth7")
id = &"zhang_san"
display_name = "泼皮张三"
sprite = ExtResource("6_vxuke")
cell = Vector2i(31, 7)
lines = PackedStringArray("泼皮张三：听说新来了个胖和尚管菜园？兄弟们正要去「贺喜」呢，嘿嘿。", "（张三朝粪窖那边使了个眼色。）")

[sub_resource type="Resource" id="Resource_s2na7"]
