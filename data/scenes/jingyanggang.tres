[sub_resource type="Resource" id="Resource_4eamn"]
script = ExtResource("5_da31b")
id = &"jiu_jia"
display_name = "酒家"
sprite = ExtResource("6_57xjs")
cell = Vector2i(26, 41)
lines = PackedStringArray("客官，小店的酒叫「出门倒」，三碗不过冈。", "如今冈上的大虫是没了，野猪野狼倒越发多了，往上走越凶，客官小心。")

[sub_resource type="Resource" id="Resource_ws1fs"]
script = ExtResource("5_da31b")
id = &"gao_shi_lan"
display_name = "告示栏"
sprite = ExtResource("7_vxwnx")
cell = Vector2i(32, 38)
lines = PackedStringArray("阳谷县衙的告示：冈上野猪伤人，有能捉的，官府给赏。")
action = &"bounties"
still = true

[sub_resource type="Resource" id="Resource_4n3ch"]
script = ExtResource("5_da31b")
id = &"lie_hu"
display_name = "猎户"
sprite = ExtResource("8_q1v0b")
cell = Vector2i(40, 23)
lines = PackedStringArray("前些日子打虎的那位好汉，我们几个披着虎皮在冈上埋伏，倒被他吓了一跳。", "山神庙后头那片空地，野猪最多；冈顶上那几窝，连我们猎户都不敢去。")

[sub_resource type="Resource" id="Resource_0qk6q"]
script = ExtResource("5_da31b")
id = &"qiao_fu"
display_name = "樵夫"
sprite = ExtResource("9_eh6ac")
cell = Vector2i(18, 11)
lines = PackedStringArray("我在这冈上砍了三十年柴，西边那块大石头底下，好像有人埋过东西。")

