display_name = "老农"
sprite = ExtResource("6_qqsic")
cell = Vector2i(46, 23)
lines = PackedStringArray("后生，往西是林子，往西南是乱坟岗，天一黑就有野狼出没。", "林子里还有剪径的强人，乱岗上那几个盗墓贼更是心狠手辣。", "越往里头越凶险，没几分本事可别去。")

