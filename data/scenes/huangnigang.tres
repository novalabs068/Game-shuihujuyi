[sub_resource type="Resource" id="Resource_iis1s"]
script = ExtResource("4_vb5c4")
id = &"jiu_jia"
display_name = "酒店主人"
sprite = ExtResource("5_d15qt")
cell = Vector2i(49, 31)
lines = PackedStringArray("客官打哪里来？前些日子冈上出了大事，十万贯的生辰纲叫人劫了，官府天天来搜。", "南边乱石沟里埋伏着官府的弓手，客官要是没犯事，别往那边去。")

[sub_resource type="Resource" id="Resource_esetc"]
script = ExtResource("4_vb5c4")
id = &"gao_shi_lan"
display_name = "告示栏"
sprite = ExtResource("6_1rage")
cell = Vector2i(10, 20)
lines = PackedStringArray("济州府的海捕文书：黄泥冈劫取生辰纲的贼人，有知情者重赏。")
action = &"bounties"
still = true

[sub_resource type="Resource" id="Resource_lsapw"]
script = ExtResource("4_vb5c4")
id = &"qiao_fu"
display_name = "樵夫"
sprite = ExtResource("7_vxnt8")
cell = Vector2i(34, 20)
lines = PackedStringArray("那天冈上停着七辆江州车，几个贩枣子的客人在树下乘凉……后来就听说生辰纲没了。", "车子还扔在冈顶的松林里，没人敢动。")

