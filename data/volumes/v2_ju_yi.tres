level_min = 60
level_max = 80
affairs = PackedStringArray("江州劫法场", "白龙庙小聚义", "三打祝家庄", "高唐州破妖法", "破连环马", "三山聚义打青州", "曾头市", "大名府救卢俊义", "东平府、东昌府")
new_play = PackedStringArray("限时救人：几个回合内冲到刑场", "连番大战：几仗连着打，中间不回血", "盘陀路：记住白杨树才能走出来", "对症下药：钩镰枪才破得了连环马")
