script = ExtResource("1_vol")
id = &"v2_ju_yi"
order = 2
title = "卷二　聚义"
era = "梁山泊一天天壮大"
summary = "宋江在江州题了反诗被判斩首，梁山好汉劫了法场；此后三打祝家庄、破连环马、打青州、救卢俊义，梁山泊越聚越多。"
rumor = "江州传来消息：有个黑矮汉子在酒楼上题了反诗，秋后就要问斩。又听说独龙冈祝家庄扬言要踏平梁山……"
side_story = false
