[sub_resource type="Resource" id="Resource_mv3fe"]
script = ExtResource("4_duos0")
id = &"gao_shi_lan"
display_name = "告示栏"
sprite = ExtResource("5_o3plx")
cell = Vector2i(22, 7)
lines = PackedStringArray("告示栏上贴着官府的海捕文书和各家的悬赏。")
action = &"bounties"
still = true

[sub_resource type="Resource" id="Resource_can2e"]
script = ExtResource("4_duos0")
id = &"huo_lang"
display_name = "货郎"
sprite = ExtResource("6_fppbj")
cell = Vector2i(12, 14)
lines = PackedStringArray("客官，看看货！刀枪护具、平安符，都是实打实的东西。")
action = &"market"

[sub_resource type="Resource" id="Resource_vm73e"]
script = ExtResource("4_duos0")
id = &"jiu_bao"
display_name = "酒保"
sprite = ExtResource("7_cuioj")
cell = Vector2i(7, 8)
lines = PackedStringArray("客官，楼上雅座还有空。", "听说渭州出了个镇关西，欺行霸市，告示栏上悬赏他呢。", "还有，城南小巷里泼皮成群结队，夜里少走动。")

[sub_resource type="Resource" id="Resource_cdsrj"]
script = ExtResource("4_duos0")
id = &"tie_jiang"
display_name = "铁匠"
sprite = ExtResource("8_801ce")
cell = Vector2i(40, 8)
lines = PackedStringArray("打铁的规矩：好钢要用在刀刃上。", "装备没法再打磨，拿到什么样就是什么样，挑合手的穿上就是。", "精品的兵器啊，只有甲等悬赏那样的硬仗才拿得到。")

[sub_resource type="Resource" id="Resource_fp05q"]
script = ExtResource("4_duos0")
id = &"shuo_shu"
display_name = "说书先生"
sprite = ExtResource("9_5ow6i")
cell = Vector2i(31, 13)
lines = PackedStringArray("（醒木一拍）列位看官！今日说一段八十万禁军教头林冲，误入白虎堂——", "这位客官，林教头的故事，你若有缘结识他本人，不妨亲自去听一听。", "江湖上的好汉，每一位都有自己的一段故事，就看你能聚起多少人了。")

[sub_resource type="Resource" id="Resource_nlc7o"]
script = ExtResource("4_duos0")
id = &"mai_hua"
display_name = "卖花姑娘"
sprite = ExtResource("10_0saps")
cell = Vector2i(21, 12)
lines = PackedStringArray("买朵花吧，大相国寺的牡丹开得正好。", "寺后的菜园新来了个胖大和尚，力气大得吓人，听说一下就把一棵柳树拔起来了！")

[sub_resource type="Resource" id="Resource_tafka"]
script = ExtResource("4_duos0")
id = &"lei_tai_jiao_tou"
display_name = "擂台教头"
sprite = ExtResource("11_801ce")
cell = Vector2i(36, 20)
lines = PackedStringArray("哪位好汉上台比划比划？一关比一关硬，打到第十关，就是和我过招了！")
action = &"arena"

